{
    "name": "shopping",
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "projectType": "application",
    "sourceRoot": "apps/shopping/src",
    "prefix": "ss",
    "targets": {
        "build": {
            "executor": "@angular-devkit/build-angular:browser",
            "outputs": ["{options.outputPath}"],
            "options": {
                "outputPath": "dist/apps/shopping",
                "index": "apps/shopping/src/index.html",
                "main": "apps/shopping/src/main.ts",
                "polyfills": "apps/shopping/src/polyfills.ts",
                "tsConfig": "apps/shopping/tsconfig.app.json",
                "inlineStyleLanguage": "scss",
                "assets": [
                    "apps/shopping/src/favicon.ico",
                    "apps/shopping/src/assets",
                    "apps/shopping/src/config",
                    {
                        "glob": "**/*",
                        "input": "libs/sales/assets/src/assets",
                        "output": "assets"
                    },
                    {
                        "glob": "**/*",
                        "input": "libs/administration/assets/src/assets",
                        "output": "assets"
                    },
                    {
                        "glob": "**/*",
                        "input": "libs/common/assets/src/assets",
                        "output": "assets"
                    },
                    {
                        "glob": "**/*",
                        "input": "libs/logistics-admin/assets/src/assets",
                        "output": "assets"
                    },
                    {
                        "glob": "**/*",
                        "input": "libs/logistics/assets/src/assets",
                        "output": "assets"
                    },
                    {
                        "glob": "**/*",
                        "input": "libs/stock/assets/src/assets",
                        "output": "assets"
                    },
                    {
                        "glob": "**/*",
                        "input": "libs/purchases/assets/src/assets",
                        "output": "assets"
                    },
                    {
                        "glob": "**/*",
                        "input": "libs/business-logic-msgs/assets/src/assets",
                        "output": "assets"
                    }
                ],
                "styles": ["apps/shopping/src/styles.scss"],
                "scripts": []
            },
            "configurations": {
                "production": {
                    "budgets": [
                        {
                            "type": "initial",
                            "maximumWarning": "7mb",
                            "maximumError": "8mb"
                        },
                        {
                            "type": "anyComponentStyle",
                            "maximumWarning": "7kb",
                            "maximumError": "8kb"
                        }
                    ],
                    "fileReplacements": [
                        {
                            "replace": "apps/shopping/src/environments/environment.ts",
                            "with": "apps/shopping/src/environments/environment.prod.ts"
                        }
                    ],
                    "outputHashing": "all"
                },
                "development": {
                    "buildOptimizer": false,
                    "optimization": false,
                    "vendorChunk": true,
                    "extractLicenses": false,
                    "sourceMap": true,
                    "namedChunks": true
                }
            },
            "defaultConfiguration": "production"
        },
        "serve": {
            "executor": "@angular-devkit/build-angular:dev-server",
            "configurations": {
                "production": {
                    "browserTarget": "shopping:build:production"
                },
                "development": {
                    "browserTarget": "shopping:build:development"
                }
            },
            "defaultConfiguration": "development"
        },
        "extract-i18n": {
            "executor": "@angular-devkit/build-angular:extract-i18n",
            "options": {
                "browserTarget": "shopping:build"
            }
        },
        "lint": {
            "executor": "@nrwl/linter:eslint",
            "options": {
                "lintFilePatterns": [
                    "apps/shopping/**/*.ts",
                    "apps/shopping/**/*.html"
                ]
            }
        },
        "test": {
            "executor": "@nrwl/jest:jest",
            "outputs": ["{workspaceRoot}/coverage/apps/shopping"],
            "options": {
                "jestConfig": "apps/shopping/jest.config.ts",
                "passWithNoTests": true
            }
        }
    },
    "tags": []
}
