{
    "name": "erp",
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "projectType": "application",
    "generators": {
        "@nrwl/angular:component": {
            "style": "scss"
        }
    },
    "sourceRoot": "apps/erp/src",
    "prefix": "ss",
    "targets": {
        "build": {
            "executor": "@angular-devkit/build-angular:browser",
            "options": {
                "outputPath": "dist/apps/erp",
                "index": "apps/erp/src/index.html",
                "main": "apps/erp/src/main.ts",
                "polyfills": "apps/erp/src/polyfills.ts",
                "tsConfig": "apps/erp/tsconfig.app.json",
                "aot": true,
                "assets": [
                    "apps/erp/src/favicon.ico",
                    "apps/erp/src/assets",
                    "apps/erp/src/config",
                    {
                        "glob": "**/*",
                        "input": "libs/common/assets/src/assets",
                        "output": "assets"
                    },
                    {
                        "glob": "**/*",
                        "input": "libs/accounting/assets/src/assets",
                        "output": "assets"
                    },
                    {
                        "glob": "**/*",
                        "input": "libs/treasury/assets/src/assets",
                        "output": "assets"
                    },
                    {
                        "glob": "**/*",
                        "input": "libs/stock/assets/src/assets",
                        "output": "assets"
                    },
                    {
                        "glob": "**/*",
                        "input": "libs/assets-component/src/lib/assets",
                        "output": "assets"
                    },
                    {
                        "glob": "**/*",
                        "input": "libs/hr-missions/assets/src/assets",
                        "output": "assets"
                    },
                    {
                        "glob": "**/*",
                        "input": "libs/remuneration/assets/src/assets",
                        "output": "assets"
                    },
                    {
                        "glob": "**/*",
                        "input": "libs/payroll/assets/src/assets",
                        "output": "assets"
                    },
                    {
                        "glob": "**/*",
                        "input": "libs/logistics/assets/src/assets",
                        "output": "assets"
                    },
                    {
                        "glob": "**/*",
                        "input": "libs/administration/assets/src/assets",
                        "output": "assets"
                    },
                    {
                        "glob": "**/*",
                        "input": "libs/sales/assets/src/assets",
                        "output": "assets"
                    },
                    {
                        "glob": "**/*",
                        "input": "libs/purchases/assets/src/assets",
                        "output": "assets"
                    },
                    {
                        "glob": "**/*",
                        "input": "libs/business-logic-msgs/assets/src/assets",
                        "output": "assets"
                    },
                    {
                        "glob": "**/*",
                        "input": "libs/web-arch/assets/src/assets",
                        "output": "assets"
                    },
                    {
                        "glob": "**/*",
                        "input": "libs/scheduled-sales/assets/src/assets",
                        "output": "assets"
                    },
                    {
                        "glob": "**/*",
                        "input": "libs/budget/assets/src/assets",
                        "output": "assets"
                    },
                    {
                        "glob": "**/*",
                        "input": "libs/ltm/assets/src/assets",
                        "output": "assets"
                    },
                    {
                        "glob": "**/*",
                        "input": "libs/attendance/assets/src/assets",
                        "output": "assets"
                    }
                ],
                "styles": ["apps/erp/src/styles.scss"],
                "stylePreprocessorOptions": {
                    "includePaths": ["node_modules"]
                },
                "scripts": []
            },
            "configurations": {
                "production": {
                    "fileReplacements": [
                        {
                            "replace": "apps/erp/src/environments/environment.ts",
                            "with": "apps/erp/src/environments/environment.prod.ts"
                        }
                    ],
                    "optimization": true,
                    "outputHashing": "all",
                    "sourceMap": false,
                    "namedChunks": true,
                    "extractLicenses": true,
                    "vendorChunk": false,
                    "buildOptimizer": true,
                    "budgets": [
                        {
                            "type": "initial",
                            "maximumWarning": "20mb",
                            "maximumError": "100mb"
                        },
                        {
                            "type": "anyComponentStyle",
                            "maximumWarning": "60kb",
                            "maximumError": "100kb"
                        }
                    ]
                },
                "ansej": {
                    "fileReplacements": [
                        {
                            "replace": "apps/erp/src/environments/environment.ts",
                            "with": "apps/erp/src/environments/environment.ansej.prod.ts"
                        }
                    ],
                    "optimization": true,
                    "outputHashing": "all",
                    "sourceMap": false,
                    "namedChunks": true,
                    "extractLicenses": true,
                    "vendorChunk": false,
                    "buildOptimizer": true,
                    "budgets": [
                        {
                            "type": "initial",
                            "maximumWarning": "20mb",
                            "maximumError": "100mb"
                        },
                        {
                            "type": "anyComponentStyle",
                            "maximumWarning": "60kb",
                            "maximumError": "100kb"
                        }
                    ]
                },
                "shopping": {
                    "fileReplacements": [
                        {
                            "replace": "apps/erp/src/environments/environment.ts",
                            "with": "apps/erp/src/environments/environment.shopping.prod.ts"
                        }
                    ],
                    "optimization": true,
                    "outputHashing": "all",
                    "sourceMap": false,
                    "namedChunks": true,
                    "extractLicenses": true,
                    "vendorChunk": false,
                    "buildOptimizer": true,
                    "budgets": [
                        {
                            "type": "initial",
                            "maximumWarning": "20mb",
                            "maximumError": "100mb"
                        },
                        {
                            "type": "anyComponentStyle",
                            "maximumWarning": "60kb",
                            "maximumError": "100kb"
                        }
                    ]
                },
                "prodassets": {
                    "fileReplacements": [
                        {
                            "replace": "apps/erp/src/environments/environment.ts",
                            "with": "apps/erp/src/environments/environment.assets.ts"
                        }
                    ],
                    "optimization": true,
                    "outputHashing": "all",
                    "sourceMap": false,
                    "namedChunks": true,
                    "extractLicenses": true,
                    "vendorChunk": false,
                    "buildOptimizer": true,
                    "budgets": [
                        {
                            "type": "initial",
                            "maximumWarning": "20mb",
                            "maximumError": "100mb"
                        },
                        {
                            "type": "anyComponentStyle",
                            "maximumWarning": "60kb",
                            "maximumError": "100kb"
                        }
                    ]
                },
                "badr": {
                    "fileReplacements": [
                        {
                            "replace": "apps/erp/src/environments/environment.ts",
                            "with": "apps/erp/src/environments/environment.badr.ts"
                        }
                    ],
                    "optimization": true,
                    "outputHashing": "all",
                    "sourceMap": false,
                    "namedChunks": true,
                    "extractLicenses": true,
                    "vendorChunk": false,
                    "buildOptimizer": true,
                    "budgets": [
                        {
                            "type": "initial",
                            "maximumWarning": "20mb",
                            "maximumError": "100mb"
                        },
                        {
                            "type": "anyComponentStyle",
                            "maximumWarning": "60kb",
                            "maximumError": "100kb"
                        }
                    ]
                },
                "prodansege": {
                    "fileReplacements": [
                        {
                            "replace": "apps/erp/src/environments/environment.ts",
                            "with": "apps/erp/src/environments/environment.ansege.ts"
                        }
                    ],
                    "optimization": true,
                    "outputHashing": "all",
                    "sourceMap": false,
                    "namedChunks": true,
                    "extractLicenses": true,
                    "vendorChunk": false,
                    "buildOptimizer": true,
                    "budgets": [
                        {
                            "type": "initial",
                            "maximumWarning": "20mb",
                            "maximumError": "100mb"
                        },
                        {
                            "type": "anyComponentStyle",
                            "maximumWarning": "60kb",
                            "maximumError": "100kb"
                        }
                    ]
                },
                "prodssales": {
                    "fileReplacements": [
                        {
                            "replace": "apps/erp/src/environments/environment.ts",
                            "with": "apps/erp/src/environments/environment.ssales.ts"
                        }
                    ],
                    "optimization": true,
                    "outputHashing": "all",
                    "sourceMap": false,
                    "namedChunks": true,
                    "extractLicenses": true,
                    "vendorChunk": false,
                    "buildOptimizer": true,
                    "budgets": [
                        {
                            "type": "initial",
                            "maximumWarning": "20mb",
                            "maximumError": "100mb"
                        },
                        {
                            "type": "anyComponentStyle",
                            "maximumWarning": "60kb",
                            "maximumError": "100kb"
                        }
                    ]
                },
                "devssales": {
                    "fileReplacements": [
                        {
                            "replace": "apps/erp/src/environments/environment.ts",
                            "with": "apps/erp/src/environments/environment.ssales.ts"
                        }
                    ],
                    "optimization": false,
                    "outputHashing": "all",
                    "sourceMap": true,
                    "namedChunks": true,
                    "extractLicenses": true,
                    "vendorChunk": false,
                    "buildOptimizer": false,
                    "budgets": [
                        {
                            "type": "initial",
                            "maximumWarning": "20mb",
                            "maximumError": "150mb"
                        },
                        {
                            "type": "anyComponentStyle",
                            "maximumWarning": "60kb",
                            "maximumError": "150kb"
                        }
                    ]
                },
                "devassets": {
                    "fileReplacements": [
                        {
                            "replace": "apps/erp/src/environments/environment.ts",
                            "with": "apps/erp/src/environments/environment.asset.ts"
                        }
                    ],
                    "optimization": false,
                    "outputHashing": "all",
                    "sourceMap": true,
                    "namedChunks": true,
                    "extractLicenses": true,
                    "vendorChunk": false,
                    "buildOptimizer": false,
                    "budgets": [
                        {
                            "type": "initial",
                            "maximumWarning": "20mb",
                            "maximumError": "150mb"
                        },
                        {
                            "type": "anyComponentStyle",
                            "maximumWarning": "60kb",
                            "maximumError": "150kb"
                        }
                    ]
                },
                "development": {
                    "optimization": false,
                    "outputHashing": "all",
                    "sourceMap": true,
                    "namedChunks": true,
                    "extractLicenses": true,
                    "vendorChunk": false,
                    "buildOptimizer": false,
                    "budgets": [
                        {
                            "type": "initial",
                            "maximumWarning": "20mb",
                            "maximumError": "150mb"
                        },
                        {
                            "type": "anyComponentStyle",
                            "maximumWarning": "60kb",
                            "maximumError": "150kb"
                        }
                    ]
                }
            }
        },
        "serve": {
            "executor": "@angular-devkit/build-angular:dev-server",
            "options": {
                "browserTarget": "erp:build",
                "host": "localhost",
                "ssl": false,
                "sslKey": "./cert.key",
                "sslCert": "./cert.crt"
            },
            "configurations": {
                "production": {
                    "browserTarget": "erp:build:production"
                },
                "development": {
                    "browserTarget": "erp:build:development"
                },
                "devssales": {
                    "browserTarget": "erp:build:devssales"
                }
            }
        },
        "extract-i18n": {
            "executor": "@angular-devkit/build-angular:extract-i18n",
            "options": {
                "browserTarget": "erp:build"
            }
        },
        "lint": {
            "executor": "@nrwl/linter:eslint",
            "options": {
                "lintFilePatterns": [
                    "apps/erp/src/**/*.ts",
                    "apps/erp/src/**/*.html"
                ]
            }
        },
        "test": {
            "executor": "@nrwl/jest:jest",
            "options": {
                "jestConfig": "apps/erp/jest.config.ts",
                "tsConfig": "apps/erp/tsconfig.spec.json",
                "passWithNoTests": true,
                "setupFile": "apps/erp/src/test-setup.ts"
            }
        }
    }
}
