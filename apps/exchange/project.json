{
    "name": "exchange",
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "projectType": "application",
    "sourceRoot": "apps/exchange/src",
    "prefix": "ss",
    "targets": {
        "build": {
            "executor": "@angular-devkit/build-angular:browser",
            "options": {
                "outputPath": "dist/apps/exc",
                "index": "apps/exchange/src/index.html",
                "main": "apps/exchange/src/main.ts",
                "polyfills": "apps/exchange/src/polyfills.ts",
                "tsConfig": "apps/exchange/tsconfig.app.json",
                "aot": true,
                "assets": [
                    "apps/exchange/src/favicon.ico",
                    "apps/exchange/src/assets",
                    "apps/exchange/src/config",
                    {
                        "glob": "**/*",
                        "input": "libs/common/assets/src/assets",
                        "output": "assets"
                    },
                    {
                        "glob": "**/*",
                        "input": "libs/business-logic-msgs/assets/src/assets",
                        "output": "assets"
                    },
                    {
                        "glob": "**/*",
                        "input": "libs/administration/assets/src/assets",
                        "output": "assets"
                    },
                    {
                        "glob": "**/*",
                        "input": "libs/logistics/assets/src/assets",
                        "output": "assets"
                    },
                    {
                        "glob": "**/*",
                        "input": "libs/exchange/assets/src/assets",
                        "output": "assets"
                    }
                ],
                "styles": [
                    "apps/exchange/src/styles.scss",
                    {
                        "input": "apps/erp/src/theme-0.scss",
                        "bundleName": "theme-0",
                        "inject": false
                    },
                    {
                        "input": "apps/erp/src/theme-1.scss",
                        "bundleName": "theme-1",
                        "inject": false
                    },
                    {
                        "input": "apps/erp/src/theme-2.scss",
                        "bundleName": "theme-2",
                        "inject": false
                    },
                    {
                        "input": "apps/erp/src/theme-3.scss",
                        "bundleName": "theme-3",
                        "inject": false
                    },
                    {
                        "input": "apps/erp/src/theme-4.scss",
                        "bundleName": "theme-4",
                        "inject": false
                    },
                    {
                        "input": "apps/erp/src/theme-5.scss",
                        "bundleName": "theme-5",
                        "inject": false
                    },
                    {
                        "input": "apps/erp/src/theme-6.scss",
                        "bundleName": "theme-6",
                        "inject": false
                    },
                    {
                        "input": "apps/erp/src/theme-7.scss",
                        "bundleName": "theme-7",
                        "inject": false
                    }
                ],
                "scripts": []
            },
            "configurations": {
                "production": {
                    "fileReplacements": [
                        {
                            "replace": "apps/exchange/src/environments/environment.ts",
                            "with": "apps/exchange/src/environments/environment.prod.ts"
                        }
                    ],
                    "optimization": true,
                    "outputHashing": "all",
                    "sourceMap": false,
                    "namedChunks": false,
                    "extractLicenses": true,
                    "vendorChunk": false,
                    "buildOptimizer": true,
                    "budgets": [
                        {
                            "type": "initial",
                            "maximumWarning": "20mb",
                            "maximumError": "100mb"
                        },
                        {
                            "type": "anyComponentStyle",
                            "maximumWarning": "60kb",
                            "maximumError": "100kb"
                        }
                    ]
                },
                "development": {
                    "fileReplacements": [
                        {
                            "replace": "apps/exchange/src/environments/environment.ts",
                            "with": "apps/exchange/src/environments/environment.ts"
                        }
                    ],
                    "optimization": false,
                    "outputHashing": "all",
                    "sourceMap": true,
                    "namedChunks": false,
                    "extractLicenses": true,
                    "vendorChunk": false,
                    "buildOptimizer": true,
                    "budgets": [
                        {
                            "type": "initial",
                            "maximumWarning": "20mb",
                            "maximumError": "100mb"
                        },
                        {
                            "type": "anyComponentStyle",
                            "maximumWarning": "60kb",
                            "maximumError": "100kb"
                        }
                    ]
                }
            }
        },
        "serve": {
            "executor": "@angular-devkit/build-angular:dev-server",
            "configurations": {
                "production": {
                    "buildTarget": "exchange:build:production"
                },
                "development": {
                    "buildTarget": "exchange:build:development"
                }
            },
            "defaultConfiguration": "development"
        },
        "extract-i18n": {
            "executor": "@angular-devkit/build-angular:extract-i18n",
            "options": {
                "browserTarget": "exchange:build"
            }
        },
        "lint": {
            "executor": "@nx/linter:eslint",
            "options": {
                "lintFilePatterns": [
                    "apps/exchange/src/**/*.ts",
                    "apps/exchange/src/**/*.html"
                ]
            }
        },
        "test": {
            "executor": "@nx/jest:jest",
            "outputs": ["{workspaceRoot}/coverage/apps/exchange"],
            "options": {
                "jestConfig": "apps/exchange/jest.config.ts",
                "passWithNoTests": true
            }
        }
    }
}
