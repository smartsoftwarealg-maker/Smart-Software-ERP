{
    "projectType": "application",
    "root": "apps/exchange",
    "sourceRoot": "apps/exchange/src",
    "prefix": "ss",
    "architect": {
        "build": {
            "builder": "@angular-devkit/build-angular:browser",
            "options": {
                "outputPath": "dist/apps/exc",
                "index": "apps/exchange/src/index.html",
                "main": "apps/exchange/src/main.ts",
                "polyfills": "apps/exchange/src/polyfills.ts",
                "tsConfig": "apps/exchange/tsconfig.app.json",
                "aot": true,
                "assets": [
                    "apps/exchange/src/favicon.ico",
                    "apps/exchange/src/assets",
                    "apps/exchange/src/config",
                    {
                        "glob": "**/*",
                        "input": "libs/common/assets/src/assets",
                        "output": "assets"
                    },
                    {
                        "glob": "**/*",
                        "input": "libs/business-logic-msgs/assets/src/assets",
                        "output": "assets"
                    },
                    {
                        "glob": "**/*",
                        "input": "libs/administration/assets/src/assets",
                        "output": "assets"
                    },
                    {
                        "glob": "**/*",
                        "input": "libs/logistics/assets/src/assets",
                        "output": "assets"
                    },
                    {
                        "glob": "**/*",
                        "input": "libs/exchange/assets/src/assets",
                        "output": "assets"
                    }
                ],
                "styles": ["apps/exchange/src/styles.scss"],
                "scripts": []
            },
            "configurations": {
                "production": {
                    "fileReplacements": [
                        {
                            "replace": "apps/exchange/src/environments/environment.ts",
                            "with": "apps/exchange/src/environments/environment.prod.ts"
                        }
                    ],
                    "optimization": true,
                    "outputHashing": "all",
                    "sourceMap": false,
                    "namedChunks": false,
                    "extractLicenses": true,
                    "vendorChunk": false,
                    "buildOptimizer": true,
                    "budgets": [
                        {
                            "type": "initial",
                            "maximumWarning": "20mb",
                            "maximumError": "100mb"
                        },
                        {
                            "type": "anyComponentStyle",
                            "maximumWarning": "60kb",
                            "maximumError": "100kb"
                        }
                    ]
                },
                "development": {
                    "fileReplacements": [
                        {
                            "replace": "apps/exchange/src/environments/environment.ts",
                            "with": "apps/exchange/src/environments/environment.prod.ts"
                        }
                    ],
                    "optimization": false,
                    "outputHashing": "all",
                    "sourceMap": true,
                    "namedChunks": false,
                    "extractLicenses": true,
                    "vendorChunk": false,
                    "buildOptimizer": true,
                    "budgets": [
                        {
                            "type": "initial",
                            "maximumWarning": "20mb",
                            "maximumError": "100mb"
                        },
                        {
                            "type": "anyComponentStyle",
                            "maximumWarning": "60kb",
                            "maximumError": "100kb"
                        }
                    ]
                }
            }
        },
        "serve": {
            "builder": "@angular-devkit/build-angular:dev-server",
            "options": {
                "browserTarget": "exchange:build"
            },
            "configurations": {
                "production": {
                    "browserTarget": "exchange:build:production"
                },
                "development": {
                    "browserTarget": "exchange:build:development"
                }
            }
        },
        "extract-i18n": {
            "builder": "@angular-devkit/build-angular:extract-i18n",
            "options": {
                "browserTarget": "exchange:build"
            }
        },
        "lint": {
            "builder": "@nrwl/linter:eslint",
            "options": {
                "lintFilePatterns": [
                    "apps/exchange/src/**/*.ts",
                    "apps/exchange/src/**/*.html"
                ]
            }
        },
        "test": {
            "builder": "@nrwl/jest:jest",
            "outputs": ["coverage/apps/exchange"],
            "options": {
                "jestConfig": "apps/exchange/jest.config.js",
                "passWithNoTests": true
            }
        }
    }
}
