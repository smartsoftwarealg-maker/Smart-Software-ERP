{
    "version": "2.0",
    "info": "Config format was changed, contact Muaaz (muaaz.h.is@gmail.com) for help",
    "info2": "You can Still use the old format, it will work.",
    "protocol": "http://",
    "defaultUrl": "localhost:8080",
    "urlRules": [
        {
            "frontend": "?",
            "backend": "localhost:8080",
            "comment": "BackEnd is same as FrontEnd, but with port 9999"
        }
    ],
    "useBrowserLanguage": true,
    "defaultLanguage": "ar",
    "languages": [
        {
            "code": "ar",
            "dir": "rtl",
            "name": "العربية",
            "dateFormat": "default",
            "personFullNameFormat": "default"
        },
        {
            "code": "en",
            "dir": "ltr",
            "name": "English",
            "dateFormat": "default",
            "personFullNameFormat": "default"
        },
        {
            "code": "fr",
            "dir": "ltr",
            "name": "Français",
            "dateFormat": "fr",
            "personFullNameFormat": "fr"
        },
        {
            "code": "tr",
            "dir": "ltr",
            "name": "Türkçe",
            "dateFormat": "default",
            "personFullNameFormat": "default"
        }
    ]
}
