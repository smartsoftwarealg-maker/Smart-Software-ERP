{
    "comments": [
        "Config format was changed, contact Muaaz (muaaz.h.is@gmail.com) for help",
        "You can Still use the old format, it will work.",
        "        ",
        "URL Rules examples: ",
        "        frontend: ?",
        "        backend:  ?:9999",
        "    BackEnd is same as FrontEnd, but with port 9999",
        "        ",
        "        frontend  ?:4430",
        "        backend   ?:9998",
        "    BackEnd is same as FrontEnd if the frontend is on port 4430, but with port 9998"
    ],
    "version": "3.0",
    "protocol": "https://",
    "defaultUrl": "localhost:8080",
    "urlRules": [
        {
            "frontend": "?",
            "backend": "demo.smartsoftware-dz.com:4430"
        }
    ],
    "useBrowserLanguage": true,
    "defaultLanguage": "ar",
    "languages": [
        {
            "code": "ar",
            "dir": "rtl",
            "name": "العربية",
            "dateFormat": "default",
            "personFullNameFormat": "default"
        },
        {
            "code": "en",
            "dir": "ltr",
            "name": "English",
            "dateFormat": "default",
            "personFullNameFormat": "default"
        },
        {
            "code": "fr",
            "dir": "ltr",
            "name": "Français",
            "dateFormat": "fr",
            "personFullNameFormat": "fr"
        },
        {
            "code": "tr",
            "dir": "ltr",
            "name": "Türkçe",
            "dateFormat": "default",
            "personFullNameFormat": "default"
        }
    ]
}
