{
    "projectType": "application",
    "root": "apps/cspace",
    "sourceRoot": "apps/cspace/src",
    "prefix": "ss",
    "targets": {
        "build": {
            "executor": "@angular-devkit/build-angular:browser",
            "outputs": ["{options.outputPath}"],
            "options": {
                "outputPath": "dist/apps/cspace",
                "index": "apps/cspace/src/index.html",
                "main": "apps/cspace/src/main.ts",
                "polyfills": "apps/cspace/src/polyfills.ts",
                "tsConfig": "apps/cspace/tsconfig.app.json",
                "inlineStyleLanguage": "scss",
                "assets": [
                    "apps/cspace/src/favicon.ico",
                    "apps/cspace/src/assets",
                    "apps/cspace/src/config",
                    {
                        "glob": "**/*",
                        "input": "libs/common/assets/src/assets",
                        "output": "assets"
                    },
                    {
                        "glob": "**/*",
                        "input": "libs/logistics/assets/src/assets",
                        "output": "assets"
                    },
                    {
                        "glob": "**/*",
                        "input": "libs/administration/assets/src/assets",
                        "output": "assets"
                    }
                ],
                "styles": ["apps/cspace/src/styles.scss"],
                "scripts": []
            },
            "configurations": {
                "production": {
                    "budgets": [
                        {
                            "type": "initial",
                            "maximumWarning": "5000kb",
                            "maximumError": "10mb"
                        },
                        {
                            "type": "anyComponentStyle",
                            "maximumWarning": "20kb",
                            "maximumError": "40kb"
                        }
                    ],
                    "fileReplacements": [
                        {
                            "replace": "apps/cspace/src/environments/environment.ts",
                            "with": "apps/cspace/src/environments/environment.prod.ts"
                        }
                    ],
                    "outputHashing": "all"
                },
                "development": {
                    "buildOptimizer": false,
                    "optimization": false,
                    "vendorChunk": true,
                    "extractLicenses": false,
                    "sourceMap": true,
                    "namedChunks": true
                }
            },
            "defaultConfiguration": "production"
        },
        "serve": {
            "executor": "@angular-devkit/build-angular:dev-server",
            "configurations": {
                "production": {
                    "browserTarget": "cspace:build:production"
                },
                "development": {
                    "browserTarget": "cspace:build:development"
                }
            },
            "defaultConfiguration": "development"
        },
        "extract-i18n": {
            "executor": "@angular-devkit/build-angular:extract-i18n",
            "options": {
                "browserTarget": "cspace:build"
            }
        },
        "lint": {
            "executor": "@nrwl/linter:eslint",
            "options": {
                "lintFilePatterns": [
                    "apps/cspace/src/**/*.ts",
                    "apps/cspace/src/**/*.html"
                ]
            }
        },
        "test": {
            "executor": "@nrwl/jest:jest",
            "outputs": ["coverage/apps/cspace"],
            "options": {
                "jestConfig": "apps/cspace/jest.config.js",
                "passWithNoTests": true
            }
        }
    }
}
