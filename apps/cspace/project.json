{
    "name": "cspace",
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "projectType": "application",
    "sourceRoot": "apps/cspace/src",
    "prefix": "ss",
    "targets": {
        "build": {
            "executor": "@angular-devkit/build-angular:browser",
            "outputs": ["{options.outputPath}"],
            "options": {
                "outputPath": "dist/apps/cspace",
                "index": "apps/cspace/src/index.html",
                "main": "apps/cspace/src/main.ts",
                "polyfills": "apps/cspace/src/polyfills.ts",
                "tsConfig": "apps/cspace/tsconfig.app.json",
                "inlineStyleLanguage": "scss",
                "assets": [
                    "apps/cspace/src/favicon.ico",
                    "apps/cspace/src/assets",
                    "apps/cspace/src/config",
                    {
                        "glob": "**/*",
                        "input": "libs/common/assets/src/assets",
                        "output": "assets"
                    },
                    {
                        "glob": "**/*",
                        "input": "libs/business-logic-msgs/assets/src/assets",
                        "output": "assets"
                    },
                    {
                        "glob": "**/*",
                        "input": "libs/scheduled-sales/assets/src/assets",
                        "output": "assets"
                    },
                    {
                        "glob": "**/*",
                        "input": "libs/sales/assets/src/assets",
                        "output": "assets"
                    },
                    {
                        "glob": "**/*",
                        "input": "libs/administration/assets/src/assets",
                        "output": "assets"
                    },
                    {
                        "glob": "**/*",
                        "input": "libs/logistics/assets/src/assets",
                        "output": "assets"
                    }

                ],
                "styles": [
                    "apps/cspace/src/styles.scss",
                    {
                        "input": "apps/erp/src/theme-0.scss",
                        "bundleName": "theme-0",
                        "inject": false
                    },
                    {
                        "input": "apps/erp/src/theme-1.scss",
                        "bundleName": "theme-1",
                        "inject": false
                    },
                    {
                        "input": "apps/erp/src/theme-2.scss",
                        "bundleName": "theme-2",
                        "inject": false
                    },
                    {
                        "input": "apps/erp/src/theme-3.scss",
                        "bundleName": "theme-3",
                        "inject": false
                    },
                    {
                        "input": "apps/erp/src/theme-4.scss",
                        "bundleName": "theme-4",
                        "inject": false
                    },
                    {
                        "input": "apps/erp/src/theme-5.scss",
                        "bundleName": "theme-5",
                        "inject": false
                    },
                    {
                        "input": "apps/erp/src/theme-6.scss",
                        "bundleName": "theme-6",
                        "inject": false
                    },
                    {
                        "input": "apps/erp/src/theme-7.scss",
                        "bundleName": "theme-7",
                        "inject": false
                    }
                ],
                "stylePreprocessorOptions": {
                    "includePaths": ["node_modules"]
                },
                "scripts": []
            },
            "configurations": {
                "production": {
                    "budgets": [
                        {
                            "type": "initial",
                            "maximumWarning": "5000kb",
                            "maximumError": "12mb"
                        },
                        {
                            "type": "anyComponentStyle",
                            "maximumWarning": "20kb",
                            "maximumError": "40kb"
                        }
                    ],
                    "fileReplacements": [
                        {
                            "replace": "apps/cspace/src/environments/environment.ts",
                            "with": "apps/cspace/src/environments/environment.prod.ts"
                        }
                    ],
                    "outputHashing": "all"
                },
                "schs": {
                    "budgets": [
                        {
                            "type": "initial",
                            "maximumWarning": "5000kb",
                            "maximumError": "10mb"
                        },
                        {
                            "type": "anyComponentStyle",
                            "maximumWarning": "20kb",
                            "maximumError": "40kb"
                        }
                    ],
                    "fileReplacements": [
                        {
                            "replace": "apps/cspace/src/environments/environment.ts",
                            "with": "apps/cspace/src/environments/environment.schs.ts"
                        }
                    ],
                    "outputHashing": "all"
                },
                "ecde": {
                    "budgets": [
                        {
                            "type": "initial",
                            "maximumWarning": "5000kb",
                            "maximumError": "10mb"
                        },
                        {
                            "type": "anyComponentStyle",
                            "maximumWarning": "20kb",
                            "maximumError": "40kb"
                        }
                    ],
                    "fileReplacements": [
                        {
                            "replace": "apps/cspace/src/environments/environment.ts",
                            "with": "apps/cspace/src/environments/environment.ecde.ts"
                        }
                    ],
                    "outputHashing": "all"
                },
                "development": {
                    "buildOptimizer": false,
                    "optimization": false,
                    "vendorChunk": true,
                    "extractLicenses": false,
                    "sourceMap": true,
                    "namedChunks": true
                }
            },
            "defaultConfiguration": "production"
        },
        "serve": {
            "executor": "@angular-devkit/build-angular:dev-server",
            "configurations": {
                "production": {
                    "buildTarget": "cspace:build:production"
                },
                "development": {
                    "buildTarget": "cspace:build:development"
                }
            },
            "defaultConfiguration": "development"
        },
        "extract-i18n": {
            "executor": "@angular-devkit/build-angular:extract-i18n",
            "options": {
                "buildTarget": "cspace:build"
            }
        },
        "lint": {
            "executor": "@nx/linter:eslint",
            "options": {
                "lintFilePatterns": [
                    "apps/cspace/src/**/*.ts",
                    "apps/cspace/src/**/*.html"
                ]
            }
        },
        "test": {
            "executor": "@nx/jest:jest",
            "outputs": ["{workspaceRoot}/coverage/apps/cspace"],
            "options": {
                "jestConfig": "apps/cspace/jest.config.ts",
                "passWithNoTests": true
            }
        }
    }
}
