{
    "name": "sspace",
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "projectType": "application",
    "prefix": "app",
    "sourceRoot": "apps/sspace/src",
    "tags": [],
    "targets": {
        "build": {
            "executor": "@angular/build:application",
            "outputs": ["{options.outputPath}"],
            "options": {
                "outputPath": "dist/apps/sspace",
                "browser": "apps/sspace/src/main.ts",
                "polyfills": ["zone.js"],
                "tsConfig": "apps/sspace/tsconfig.app.json",
                "inlineStyleLanguage": "scss",
                "assets": [
                    "apps/sspace/src/assets",
                    "apps/sspace/src/config",
                    {
                        "glob": "**/*",
                        "input": "libs/common/assets/src/assets",
                        "output": "assets"
                    },
                    {
                        "glob": "**/*",
                        "input": "libs/administration/assets/src/assets",
                        "output": "assets"
                    },
                    {
                        "glob": "**/*",
                        "input": "libs/logistics/assets/src/assets",
                        "output": "assets"
                    },
                    {
                        "glob": "**/*",
                        "input": "libs/sales/assets/src/assets",
                        "output": "assets"
                    },
                    {
                        "glob": "**/*",
                        "input": "libs/common/assets/src/assets",
                        "output": "assets"
                    },
                    {
                        "glob": "**/*",
                        "input": "libs/business-logic-msgs/assets/src/assets",
                        "output": "assets"
                    },
                    {
                        "glob": "**/*",
                        "input": "libs/scheduled-sales/assets/src/assets",
                        "output": "assets"
                    },
                    {
                        "glob": "**/*",
                        "input": "apps/sspace/public"
                    }
                ],
                "styles": [
                    "apps/sspace/src/styles.scss",
                    {
                        "input": "apps/sspace/src/theme-0.scss",
                        "bundleName": "theme-0",
                        "inject": false
                    },
                    {
                        "input": "apps/sspace/src/theme-1.scss",
                        "bundleName": "theme-1",
                        "inject": false
                    },
                    {
                        "input": "apps/sspace/src/theme-2.scss",
                        "bundleName": "theme-2",
                        "inject": false
                    },
                    {
                        "input": "apps/sspace/src/theme-3.scss",
                        "bundleName": "theme-3",
                        "inject": false
                    },
                    {
                        "input": "apps/sspace/src/theme-4.scss",
                        "bundleName": "theme-4",
                        "inject": false
                    },
                    {
                        "input": "apps/sspace/src/theme-5.scss",
                        "bundleName": "theme-5",
                        "inject": false
                    },
                    {
                        "input": "apps/sspace/src/theme-6.scss",
                        "bundleName": "theme-6",
                        "inject": false
                    },
                    {
                        "input": "apps/sspace/src/theme-7.scss",
                        "bundleName": "theme-7",
                        "inject": false
                    }
                ],
                "stylePreprocessorOptions": {
                    "includePaths": ["node_modules"]
                },
                "scripts": []
            },
            "configurations": {
                "production": {
                    "budgets": [
                        {
                            "type": "initial",
                            "maximumWarning": "5000kb",
                            "maximumError": "10mb"
                        },
                        {
                            "type": "anyComponentStyle",
                            "maximumWarning": "40kb",
                            "maximumError": "80kb"
                        }
                    ],
                    "outputHashing": "all"
                },
                "development": {
                    "optimization": false,
                    "extractLicenses": false,
                    "sourceMap": true
                }
            },
            "defaultConfiguration": "production"
        },
        "serve": {
            "continuous": true,
            "executor": "@angular/build:dev-server",
            "configurations": {
                "production": {
                    "buildTarget": "sspace:build:production"
                },
                "development": {
                    "buildTarget": "sspace:build:development"
                }
            },
            "defaultConfiguration": "development"
        },
        "extract-i18n": {
            "executor": "@angular/build:extract-i18n",
            "options": {
                "buildTarget": "sspace:build"
            }
        },
        "lint": {
            "executor": "@nx/eslint:lint"
        },
        "test": {
            "executor": "@nx/jest:jest",
            "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
            "options": {
                "jestConfig": "apps/sspace/jest.config.ts",
                "tsConfig": "apps/sspace/tsconfig.spec.json"
            }
        },
        "serve-static": {
            "continuous": true,
            "executor": "@nx/web:file-server",
            "options": {
                "buildTarget": "sspace:build",
                "port": 4200,
                "staticFilePath": "dist/apps/sspace/browser",
                "spa": true
            }
        }
    }
}
