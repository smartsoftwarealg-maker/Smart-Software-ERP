{
    "version": "3.0",
    "protocol": "https://",
    "defaultUrl": "smartsoft.hopto.org:9999",
    "urlRules": [
        {
            "frontend": "?",
            "backend": "smartsoft.hopto.org:4430"
        }
    ],
    "useBrowserLanguage": true,
    "defaultLanguage": "ar",
    "languages": [
        {
            "code": "ar",
            "dir": "rtl",
            "name": "العربية",
            "dateFormat": "default",
            "personFullNameFormat": "default"
        },
        {
            "code": "en",
            "dir": "ltr",
            "name": "English",
            "dateFormat": "default",
            "personFullNameFormat": "default"
        },
        {
            "code": "fr",
            "dir": "ltr",
            "name": "Français",
            "dateFormat": "fr",
            "personFullNameFormat": "fr"
        },
        {
            "code": "tr",
            "dir": "ltr",
            "name": "Türkçe",
            "dateFormat": "default",
            "personFullNameFormat": "default"
        }
    ]
}
