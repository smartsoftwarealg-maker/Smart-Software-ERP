{
    "name": "administration-ui-roles",
    "$schema": "../../../node_modules/nx/schemas/project-schema.json",
    "projectType": "library",
    "sourceRoot": "libs/administration/ui-roles/src",
    "prefix": "ss",
    "targets": {
        "lint": {
            "executor": "@angular-devkit/build-angular:tslint",
            "options": {
                "tsConfig": [
                    "libs/administration/ui-roles/tsconfig.lib.json",
                    "libs/administration/ui-roles/tsconfig.spec.json"
                ],
                "exclude": [
                    "**/node_modules/**",
                    "!libs/administration/ui-roles/**/*"
                ]
            }
        },
        "test": {
            "executor": "@nrwl/jest:jest",
            "outputs": [
                "{workspaceRoot}/coverage/libs/administration/ui-roles"
            ],
            "options": {
                "jestConfig": "libs/administration/ui-roles/jest.config.ts",
                "passWithNoTests": true
            }
        }
    }
}
