{
    "name": "administration-ui-user",
    "$schema": "../../../node_modules/nx/schemas/project-schema.json",
    "projectType": "library",
    "sourceRoot": "libs/administration/ui-user/src",
    "prefix": "ss",
    "targets": {
        "lint": {
            "executor": "@angular-devkit/build-angular:tslint",
            "options": {
                "tsConfig": [
                    "libs/administration/ui-user/tsconfig.lib.json",
                    "libs/administration/ui-user/tsconfig.spec.json"
                ],
                "exclude": [
                    "**/node_modules/**",
                    "!libs/administration/ui-user/**/*"
                ]
            }
        },
        "test": {
            "executor": "@nx/jest:jest",
            "outputs": ["{workspaceRoot}/coverage/libs/administration/ui-user"],
            "options": {
                "jestConfig": "libs/administration/ui-user/jest.config.ts",
                "passWithNoTests": true
            }
        }
    }
}
