{
    "name": "hr-missions-assets",
    "$schema": "../../../node_modules/nx/schemas/project-schema.json",
    "projectType": "library",
    "sourceRoot": "libs/hr-missions/assets/src",
    "prefix": "ss",
    "targets": {
        "test": {
            "executor": "@nx/jest:jest",
            "outputs": ["{workspaceRoot}/coverage/libs/hr-missions/assets"],
            "options": {
                "jestConfig": "libs/hr-missions/assets/jest.config.js",
                "passWithNoTests": true
            }
        },
        "lint": {
            "executor": "@nx/linter:eslint",
            "options": {
                "lintFilePatterns": [
                    "libs/hr-missions/assets/src/**/*.ts",
                    "libs/hr-missions/assets/src/**/*.html"
                ]
            }
        }
    },
    "tags": []
}
