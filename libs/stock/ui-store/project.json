{
    "name": "stock-ui-store",
    "$schema": "../../../node_modules/nx/schemas/project-schema.json",
    "projectType": "library",
    "sourceRoot": "libs/stock/ui-store/src",
    "prefix": "ss",
    "targets": {
        "test": {
            "executor": "@nrwl/jest:jest",
            "outputs": ["{workspaceRoot}/coverage/libs/stock/ui-store"],
            "options": {
                "jestConfig": "libs/stock/ui-store/jest.config.ts",
                "passWithNoTests": true
            }
        },
        "lint": {
            "executor": "@nrwl/linter:eslint",
            "options": {
                "lintFilePatterns": [
                    "libs/stock/ui-store/src/**/*.ts",
                    "libs/stock/ui-store/src/**/*.html"
                ]
            }
        }
    }
}
