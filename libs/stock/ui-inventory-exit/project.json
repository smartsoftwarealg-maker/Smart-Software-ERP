{
    "name": "stock-ui-inventory-exit",
    "$schema": "../../../node_modules/nx/schemas/project-schema.json",
    "projectType": "library",
    "sourceRoot": "libs/stock/ui-inventory-exit/src",
    "prefix": "ss",
    "targets": {
        "lint": {
            "executor": "@angular-devkit/build-angular:tslint",
            "options": {
                "tsConfig": [
                    "libs/stock/ui-inventory-exit/tsconfig.lib.json",
                    "libs/stock/ui-inventory-exit/tsconfig.spec.json"
                ],
                "exclude": [
                    "**/node_modules/**",
                    "!libs/stock/ui-inventory-exit/**/*"
                ]
            }
        },
        "test": {
            "executor": "@nx/jest:jest",
            "options": {
                "jestConfig": "libs/stock/ui-inventory-exit/jest.config.ts",
                "tsConfig": "libs/stock/ui-inventory-exit/tsconfig.spec.json",
                "passWithNoTests": true,
                "setupFile": "libs/stock/ui-inventory-exit/src/test-setup.ts"
            }
        }
    },
    "generators": {
        "@nx/angular:component": {
            "style": "scss"
        }
    }
}
