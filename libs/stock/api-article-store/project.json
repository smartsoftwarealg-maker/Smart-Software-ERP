{
    "name": "api-article-store",
    "$schema": "../../../node_modules/nx/schemas/project-schema.json",
    "projectType": "library",
    "sourceRoot": "libs/stock/api-article-store/src",
    "prefix": "ss",
    "targets": {
        "lint": {
            "executor": "@angular-devkit/build-angular:tslint",
            "options": {
                "tsConfig": [
                    "libs/stock/api-article-store/tsconfig.lib.json",
                    "libs/stock/api-article-store/tsconfig.spec.json"
                ],
                "exclude": [
                    "**/node_modules/**",
                    "!libs/stock/api-article-store/**/*"
                ]
            }
        },
        "test": {
            "executor": "@nrwl/jest:jest",
            "outputs": [
                "{workspaceRoot}/coverage/libs/stock/api-article-store"
            ],
            "options": {
                "jestConfig": "libs/stock/api-article-store/jest.config.ts",
                "passWithNoTests": true
            }
        }
    }
}
