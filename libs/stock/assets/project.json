{
    "$schema": "../../../node_modules/nx/schemas/project-schema.json",
    "projectType": "library",
    "sourceRoot": "libs/stock/assets/src",
    "prefix": "ss",
    "targets": {
        "lint": {
            "executor": "@angular-devkit/build-angular:tslint",
            "options": {
                "tsConfig": [
                    "libs/stock/assets/tsconfig.lib.json",
                    "libs/stock/assets/tsconfig.spec.json"
                ],
                "exclude": ["**/node_modules/**", "!libs/stock/assets/**/*"]
            }
        }
    },
    "generators": {
        "@nrwl/angular:component": {
            "style": "scss"
        }
    }
}
