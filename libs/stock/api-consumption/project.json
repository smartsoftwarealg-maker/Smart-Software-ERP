{
    "name": "stock-api-consumption",
    "$schema": "../../../node_modules/nx/schemas/project-schema.json",
    "projectType": "library",
    "sourceRoot": "libs/stock/api-consumption/src",
    "prefix": "ss",
    "generators": {
        "@nx/angular:component": {
            "style": "scss"
        }
    },
    "targets": {
        "lint": {
            "executor": "@angular-devkit/build-angular:tslint",
            "options": {
                "tsConfig": [
                    "libs/stock/api-consumption/tsconfig.lib.json",
                    "libs/stock/api-consumption/tsconfig.spec.json"
                ],
                "exclude": [
                    "**/node_modules/**",
                    "!libs/stock/api-consumption/**/*"
                ]
            }
        },
        "test": {
            "executor": "@nx/jest:jest",
            "options": {
                "jestConfig": "libs/stock/api-consumption/jest.config.ts",
                "tsConfig": "libs/stock/api-consumption/tsconfig.spec.json",
                "passWithNoTests": true
            }
        }
    }
}
