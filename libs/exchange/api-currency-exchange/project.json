{
    "projectType": "library",
    "root": "libs/exchange/api-currency-exchange",
    "sourceRoot": "libs/exchange/api-currency-exchange/src",
    "prefix": "ss",
    "architect": {
        "lint": {
            "builder": "@nrwl/linter:eslint",
            "options": {
                "lintFilePatterns": [
                    "libs/exchange/api-currency-exchange/src/**/*.ts",
                    "libs/exchange/api-currency-exchange/src/**/*.html"
                ]
            }
        },
        "test": {
            "builder": "@nrwl/jest:jest",
            "outputs": ["coverage/libs/exchange/api-currency-exchange"],
            "options": {
                "jestConfig": "libs/exchange/api-currency-exchange/jest.config.js",
                "passWithNoTests": true
            }
        }
    }
}
