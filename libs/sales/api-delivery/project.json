{
    "projectType": "library",
    "root": "libs/sales/api-delivery",
    "sourceRoot": "libs/sales/api-delivery/src",
    "prefix": "ss",
    "architect": {
        "lint": {
            "builder": "@angular-devkit/build-angular:tslint",
            "options": {
                "tsConfig": [
                    "libs/sales/api-delivery/tsconfig.lib.json",
                    "libs/sales/api-delivery/tsconfig.spec.json"
                ],
                "exclude": [
                    "**/node_modules/**",
                    "!libs/sales/api-delivery/**/*"
                ]
            }
        },
        "test": {
            "builder": "@nrwl/jest:jest",
            "outputs": ["coverage/libs/sales/api-delivery"],
            "options": {
                "jestConfig": "libs/sales/api-delivery/jest.config.js",
                "passWithNoTests": true
            }
        }
    }
}
