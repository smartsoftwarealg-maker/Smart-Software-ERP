{
    "projectType": "library",
    "root": "libs/sales/ui-invoice",
    "sourceRoot": "libs/sales/ui-invoice/src",
    "prefix": "ss",
    "targets": {
        "lint": {
            "executor": "@angular-devkit/build-angular:tslint",
            "options": {
                "tsConfig": [
                    "libs/sales/ui-invoice/tsconfig.lib.json",
                    "libs/sales/ui-invoice/tsconfig.spec.json"
                ],
                "exclude": ["**/node_modules/**", "!libs/sales/ui-invoice/**/*"]
            }
        },
        "test": {
            "executor": "@nrwl/jest:jest",
            "outputs": ["coverage/libs/sales/ui-invoice"],
            "options": {
                "jestConfig": "libs/sales/ui-invoice/jest.config.js",
                "passWithNoTests": true
            }
        }
    }
}
