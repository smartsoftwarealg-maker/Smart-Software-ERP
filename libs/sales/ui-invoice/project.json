{
    "name": "sales-ui-invoice",
    "$schema": "../../../node_modules/nx/schemas/project-schema.json",
    "projectType": "library",
    "sourceRoot": "libs/sales/ui-invoice/src",
    "prefix": "ss",
    "targets": {
        "lint": {
            "executor": "@angular-devkit/build-angular:tslint",
            "options": {
                "tsConfig": [
                    "libs/sales/ui-invoice/tsconfig.lib.json",
                    "libs/sales/ui-invoice/tsconfig.spec.json"
                ],
                "exclude": ["**/node_modules/**", "!libs/sales/ui-invoice/**/*"]
            }
        },
        "test": {
            "executor": "@nx/jest:jest",
            "outputs": ["{workspaceRoot}/coverage/libs/sales/ui-invoice"],
            "options": {
                "jestConfig": "libs/sales/ui-invoice/jest.config.ts",
                "passWithNoTests": true
            }
        }
    }
}
