{
    "name": "custom-attributes",
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "projectType": "library",
    "sourceRoot": "libs/custom-attributes/src",
    "prefix": "ss",
    "targets": {
        "test": {
            "executor": "@nrwl/jest:jest",
            "outputs": ["{workspaceRoot}/coverage/libs/custom-attributes"],
            "options": {
                "jestConfig": "libs/custom-attributes/jest.config.ts",
                "passWithNoTests": true
            }
        },
        "lint": {
            "executor": "@nrwl/linter:eslint",
            "options": {
                "lintFilePatterns": [
                    "libs/custom-attributes/src/**/*.ts",
                    "libs/custom-attributes/src/**/*.html"
                ]
            }
        }
    },
    "tags": []
}
