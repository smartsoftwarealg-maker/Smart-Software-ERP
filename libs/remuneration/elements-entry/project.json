{
    "name": "remuneration-elements-entry",
    "$schema": "../../../node_modules/nx/schemas/project-schema.json",
    "projectType": "library",
    "sourceRoot": "libs/remuneration/elements-entry/src",
    "prefix": "ss",
    "targets": {
        "test": {
            "executor": "@nx/jest:jest",
            "outputs": [
                "{workspaceRoot}/coverage/libs/remuneration/elements-entry"
