            "options": {
                "jestConfig": "libs/remuneration/elements-entry/jest.config.ts",
                "passWithNoTests": true
            }
        },
        "lint": {
            "executor": "@nx/linter:eslint",
            "options": {
                "lintFilePatterns": [
                    "libs/remuneration/elements-entry/src/**/*.ts",
                    "libs/remuneration/elements-entry/src/**/*.html"
                ]
            }
        }
    }
}
