{
    "projectType": "library",
    "root": "libs/common/ui-default-report-component",
    "sourceRoot": "libs/common/ui-default-report-component/src",
    "prefix": "ss",
    "targets": {
        "lint": {
            "executor": "@nrwl/linter:eslint",
            "options": {
                "lintFilePatterns": [
                    "libs/common/ui-default-report-component/src/**/*.ts",
                    "libs/common/ui-default-report-component/src/**/*.html"
                ]
            }
        },
        "test": {
            "executor": "@nrwl/jest:jest",
            "outputs": ["coverage/libs/common/ui-default-report-component"],
            "options": {
                "jestConfig": "libs/common/ui-default-report-component/jest.config.js",
                "passWithNoTests": true
            }
        }
    }
}
