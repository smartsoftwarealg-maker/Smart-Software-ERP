{
    "name": "common-api-common",
    "$schema": "../../../node_modules/nx/schemas/project-schema.json",
    "projectType": "library",
    "sourceRoot": "libs/common/api-common/src",
    "prefix": "ss",
    "targets": {
        "lint": {
            "executor": "@angular-devkit/build-angular:tslint",
            "options": {
                "tsConfig": [
                    "libs/common/api-common/tsconfig.lib.json",
                    "libs/common/api-common/tsconfig.spec.json"
                ],
                "exclude": [
                    "**/node_modules/**",
                    "!libs/common/api-common/**/*"
                ]
            }
        },
        "test": {
            "executor": "@nrwl/jest:jest",
            "options": {
                "jestConfig": "libs/common/api-common/jest.config.ts",
                "tsConfig": "libs/common/api-common/tsconfig.spec.json",
                "passWithNoTests": true,
                "setupFile": "libs/common/api-common/src/test-setup.ts"
            }
        }
    },
    "generators": {
        "@nrwl/angular:component": {
            "style": "scss"
        }
    }
}
