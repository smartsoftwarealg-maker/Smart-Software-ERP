{
    "name": "common-api-admob",
    "$schema": "../../../node_modules/nx/schemas/project-schema.json",
    "projectType": "library",
    "sourceRoot": "libs/common/api-admob/src",
    "prefix": "ss",
    "targets": {
        "lint": {
            "executor": "@nrwl/linter:eslint",
            "options": {
                "lintFilePatterns": [
                    "libs/common/api-admob/src/**/*.ts",
                    "libs/common/api-admob/src/**/*.html"
                ]
            }
        },
        "test": {
            "executor": "@nrwl/jest:jest",
            "outputs": ["{workspaceRoot}/coverage/libs/common/api-admob"],
            "options": {
                "jestConfig": "libs/common/api-admob/jest.config.ts",
                "passWithNoTests": true
            }
        }
    }
}
