{
    "$schema": "../../../node_modules/nx/schemas/project-schema.json",
    "projectType": "library",
    "sourceRoot": "libs/common/ui-auto-complete/src",
    "prefix": "ss",
    "targets": {
        "lint": {
            "executor": "@angular-devkit/build-angular:tslint",
            "options": {
                "tsConfig": [
                    "libs/common/ui-auto-complete/tsconfig.lib.json",
                    "libs/common/ui-auto-complete/tsconfig.spec.json"
                ],
                "exclude": [
                    "**/node_modules/**",
                    "!libs/common/ui-auto-complete/**/*"
                ]
            }
        },
        "test": {
            "executor": "@nrwl/jest:jest",
            "options": {
                "jestConfig": "libs/common/ui-auto-complete/jest.config.ts",
                "tsConfig": "libs/common/ui-auto-complete/tsconfig.spec.json",
                "passWithNoTests": true,
                "setupFile": "libs/common/ui-auto-complete/src/test-setup.ts"
            }
        }
    },
    "generators": {
        "@nrwl/angular:component": {
            "style": "scss"
        }
    }
}
