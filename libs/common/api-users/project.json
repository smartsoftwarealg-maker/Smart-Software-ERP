{
    "name": "common-api-users",
    "$schema": "../../../node_modules/nx/schemas/project-schema.json",
    "projectType": "library",
    "sourceRoot": "libs/common/api-users/src",
    "prefix": "ss",
    "targets": {
        "lint": {
            "executor": "@angular-devkit/build-angular:tslint",
            "options": {
                "tsConfig": [
                    "libs/common/api-users/tsconfig.lib.json",
                    "libs/common/api-users/tsconfig.spec.json"
                ],
                "exclude": ["**/node_modules/**", "!libs/common/api-users/**/*"]
            }
        },
        "test": {
            "executor": "@nx/jest:jest",
            "options": {
                "jestConfig": "libs/common/api-users/jest.config.ts",
                "tsConfig": "libs/common/api-users/tsconfig.spec.json",
                "passWithNoTests": true,
                "setupFile": "libs/common/api-users/src/test-setup.ts"
            }
        }
    },
    "generators": {
        "@nx/angular:component": {
            "style": "scss"
        }
    }
}
