{
    "projectType": "library",
    "root": "libs/payroll/ui-employee-activation",
    "sourceRoot": "libs/payroll/ui-employee-activation/src",
    "prefix": "ss",
    "targets": {
        "lint": {
            "executor": "@angular-devkit/build-angular:tslint",
            "options": {
                "tsConfig": [
                    "libs/payroll/ui-employee-activation/tsconfig.lib.json",
                    "libs/payroll/ui-employee-activation/tsconfig.spec.json"
                ],
                "exclude": [
                    "**/node_modules/**",
                    "!libs/payroll/ui-employee-activation/**/*"
                ]
            }
        },
        "test": {
            "executor": "@nrwl/jest:jest",
            "outputs": ["coverage/libs/payroll/ui-employee-activation"],
            "options": {
                "jestConfig": "libs/payroll/ui-employee-activation/jest.config.js",
                "passWithNoTests": true
            }
        }
    }
}
