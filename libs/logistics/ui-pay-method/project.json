{
    "projectType": "library",
    "root": "libs/logistics/ui-pay-method",
    "sourceRoot": "libs/logistics/ui-pay-method/src",
    "prefix": "ss",
    "targets": {
        "lint": {
            "executor": "@nrwl/linter:eslint",
            "options": {
                "lintFilePatterns": [
                    "libs/logistics/ui-pay-method/src/**/*.ts",
                    "libs/logistics/ui-pay-method/src/**/*.html"
                ]
            }
        },
        "test": {
            "executor": "@nrwl/jest:jest",
            "outputs": ["coverage/libs/logistics/ui-pay-method"],
            "options": {
                "jestConfig": "libs/logistics/ui-pay-method/jest.config.js",
                "passWithNoTests": true
            }
        }
    }
}
