{
    "projectType": "library",
    "root": "libs/logistics/payments",
    "sourceRoot": "libs/logistics/payments/src",
    "prefix": "ss",
    "architect": {
        "test": {
            "builder": "@nrwl/jest:jest",
            "outputs": ["coverage/libs/logistics/payments"],
            "options": {
                "jestConfig": "libs/logistics/payments/jest.config.js",
                "passWithNoTests": true
            }
        },
        "lint": {
            "builder": "@nrwl/linter:eslint",
            "options": {
                "lintFilePatterns": [
                    "libs/logistics/payments/src/**/*.ts",
                    "libs/logistics/payments/src/**/*.html"
                ]
            }
        }
    }
}
