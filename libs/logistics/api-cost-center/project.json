{
    "projectType": "library",
    "root": "libs/logistics/api-cost-center",
    "sourceRoot": "libs/logistics/api-cost-center/src",
    "prefix": "ss",
    "targets": {
        "lint": {
            "executor": "@angular-devkit/build-angular:tslint",
            "options": {
                "tsConfig": [
                    "libs/logistics/api-cost-center/tsconfig.lib.json",
                    "libs/logistics/api-cost-center/tsconfig.spec.json"
                ],
                "exclude": [
                    "**/node_modules/**",
                    "!libs/logistics/api-cost-center/**/*"
                ]
            }
        },
        "test": {
            "executor": "@nrwl/jest:jest",
            "options": {
                "jestConfig": "libs/logistics/api-cost-center/jest.config.js",
                "tsConfig": "libs/logistics/api-cost-center/tsconfig.spec.json",
                "passWithNoTests": true,
                "setupFile": "libs/logistics/api-cost-center/src/test-setup.ts"
            }
        }
    },
    "generators": {
        "@nrwl/angular:component": {
            "style": "scss"
        }
    }
}
