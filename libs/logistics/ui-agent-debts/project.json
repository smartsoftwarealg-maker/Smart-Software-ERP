{
    "name": "logistics-ui-agent-debts",
    "$schema": "../../../node_modules/nx/schemas/project-schema.json",
    "projectType": "library",
    "sourceRoot": "libs/logistics/ui-agent-debts/src",
    "prefix": "ss",
    "targets": {
        "lint": {
            "executor": "@angular-devkit/build-angular:tslint",
            "options": {
                "tsConfig": [
                    "libs/logistics/ui-agent-debts/tsconfig.lib.json",
                    "libs/logistics/ui-agent-debts/tsconfig.spec.json"
                ],
                "exclude": [
                    "**/node_modules/**",
                    "!libs/logistics/ui-agent-debts/**/*"
                ]
            }
        },
        "test": {
            "executor": "@nx/jest:jest",
            "outputs": [
                "{workspaceRoot}/coverage/libs/logistics/ui-agent-debts"
            ],
            "options": {
                "jestConfig": "libs/logistics/ui-agent-debts/jest.config.ts",
                "passWithNoTests": true
            }
        }
    }
}
