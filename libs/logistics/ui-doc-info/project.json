{
    "name": "logistics-ui-doc-info",
    "$schema": "../../../node_modules/nx/schemas/project-schema.json",
    "projectType": "library",
    "sourceRoot": "libs/logistics/ui-doc-info/src",
    "prefix": "ss",
    "targets": {
        "lint": {
            "executor": "@angular-devkit/build-angular:tslint",
            "options": {
                "tsConfig": [
                    "libs/logistics/ui-doc-info/tsconfig.lib.json",
                    "libs/logistics/ui-doc-info/tsconfig.spec.json"
                ],
                "exclude": [
                    "**/node_modules/**",
                    "!libs/logistics/ui-doc-info/**/*"
                ]
            }
        },
        "test": {
            "executor": "@nrwl/jest:jest",
            "outputs": ["{workspaceRoot}/coverage/libs/logistics/ui-doc-info"],
            "options": {
                "jestConfig": "libs/logistics/ui-doc-info/jest.config.ts",
                "passWithNoTests": true
            }
        }
    }
}
