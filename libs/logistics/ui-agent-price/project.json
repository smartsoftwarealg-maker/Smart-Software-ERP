{
    "name": "logistics-ui-agent-price",
    "$schema": "../../../node_modules/nx/schemas/project-schema.json",
    "projectType": "library",
    "sourceRoot": "libs/logistics/ui-agent-price/src",
    "prefix": "ss",
    "generators": {
        "@nx/angular:component": {
            "style": "scss"
        }
    },
    "targets": {
        "lint": {
            "executor": "@angular-devkit/build-angular:tslint",
            "options": {
                "tsConfig": [
                    "libs/logistics/ui-agent-price/tsconfig.lib.json",
                    "libs/logistics/ui-agent-price/tsconfig.spec.json"
                ],
                "exclude": [
                    "**/node_modules/**",
                    "!libs/logistics/ui-agent-price/**/*"
                ]
            }
        },
        "test": {
            "executor": "@nx/jest:jest",
            "options": {
                "jestConfig": "libs/logistics/ui-agent-price/jest.config.ts",
                "tsConfig": "libs/logistics/ui-agent-price/tsconfig.spec.json",
                "passWithNoTests": true
            }
        }
    }
}
