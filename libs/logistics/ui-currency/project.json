{
    "projectType": "library",
    "root": "libs/logistics/ui-currency",
    "sourceRoot": "libs/logistics/ui-currency/src",
    "prefix": "ss",
    "architect": {
        "lint": {
            "builder": "@nrwl/linter:eslint",
            "options": {
                "lintFilePatterns": [
                    "libs/logistics/ui-currency/src/**/*.ts",
                    "libs/logistics/ui-currency/src/**/*.html"
                ]
            }
        },
        "test": {
            "builder": "@nrwl/jest:jest",
            "outputs": ["coverage/libs/logistics/ui-currency"],
            "options": {
                "jestConfig": "libs/logistics/ui-currency/jest.config.js",
                "passWithNoTests": true
            }
        }
    }
}
