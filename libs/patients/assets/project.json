{
    "name": "patients-assets",
    "$schema": "../../../node_modules/nx/schemas/project-schema.json",
    "projectType": "library",
    "sourceRoot": "libs/patients/assets/src",
    "prefix": "ss",
    "targets": {
        "test": {
            "executor": "@nx/jest:jest",
            "outputs": ["{workspaceRoot}/coverage/libs/patients/assets"],
            "options": {
                "jestConfig": "libs/patients/assets/jest.config.js",
                "passWithNoTests": true
            }
        },
        "lint": {
            "executor": "@nx/linter:eslint",
            "options": {
                "lintFilePatterns": [
                    "libs/patients/assets/src/**/*.ts",
                    "libs/patients/assets/src/**/*.html"
                ]
            }
        }
    }
}
