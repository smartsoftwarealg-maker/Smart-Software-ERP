{
    "name": "patients-ui-patients",
    "$schema": "../../../node_modules/nx/schemas/project-schema.json",
    "projectType": "library",
    "sourceRoot": "libs/patients/ui-patients/src",
    "prefix": "ss",
    "targets": {
        "test": {
            "executor": "@nrwl/jest:jest",
            "outputs": ["{workspaceRoot}/coverage/libs/patients/ui-patients"],
            "options": {
                "jestConfig": "libs/patients/ui-patients/jest.config.ts",
                "passWithNoTests": true
            }
        },
        "lint": {
            "executor": "@nrwl/linter:eslint",
            "options": {
                "lintFilePatterns": [
                    "libs/patients/ui-patients/src/**/*.ts",
                    "libs/patients/ui-patients/src/**/*.html"
                ]
            }
        }
    }
}
