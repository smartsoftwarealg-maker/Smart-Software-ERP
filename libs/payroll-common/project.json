{
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "projectType": "library",
    "sourceRoot": "libs/payroll-common/src",
    "prefix": "ss",
    "targets": {
        "test": {
            "executor": "@nrwl/jest:jest",
            "outputs": ["coverage/libs/payroll-common"],
            "options": {
                "jestConfig": "libs/payroll-common/jest.config.ts",
                "passWithNoTests": true
            }
        },
        "lint": {
            "executor": "@nrwl/linter:eslint",
            "options": {
                "lintFilePatterns": [
                    "libs/payroll-common/src/**/*.ts",
                    "libs/payroll-common/src/**/*.html"
                ]
            }
        }
    },
    "tags": []
}
