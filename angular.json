        "ecommerce": {
            "projectType": "application",
            "root": "apps/ecommerce",
            "sourceRoot": "apps/ecommerce/src",
            "prefix": "ss",
            "targets": {
                "build": {
                    "executor": "@angular-devkit/build-angular:browser",
                    "outputs": ["{options.outputPath}"],
                    "options": {
                        "outputPath": "dist/apps/ecommerce",
                        "index": "apps/ecommerce/src/index.html",
                        "main": "apps/ecommerce/src/main.ts",
                        "polyfills": "apps/ecommerce/src/polyfills.ts",
                        "tsConfig": "apps/ecommerce/tsconfig.app.json",
                        "inlineStyleLanguage": "scss",
                        "assets": [
                            "apps/ecommerce/src/favicon.ico",
                            "apps/ecommerce/src/assets",
                            "apps/ecommerce/src/config",
                            {
                                "glob": "**/*",
                                "input": "libs/sales/assets/src/assets",
                                "output": "assets"
                            },
                            {
                                "glob": "**/*",
                                "input": "libs/administration/assets/src/assets",
                                "output": "assets"
                            },
                            {
                                "glob": "**/*",
                                "input": "libs/common/assets/src/assets",
                                "output": "assets"
                            },
                            {
                                "glob": "**/*",
                                "input": "libs/logistics-admin/assets/src/assets",
                                "output": "assets"
                            },
                            {
                                "glob": "**/*",
                                "input": "libs/logistics/assets/src/assets",
                                "output": "assets"
                            },
                            {
                                "glob": "**/*",
                                "input": "libs/stock/assets/src/assets",
                                "output": "assets"
                            },
                            {
                                "glob": "**/*",
                                "input": "libs/purchases/assets/src/assets",
                                "output": "assets"
                            },
                            {
                                "glob": "**/*",
                                "input": "libs/business-logic-msgs/assets/src/assets",
                                "output": "assets"
                            }
                        ],
                        "styles": ["apps/ecommerce/src/styles.scss"],
                        "scripts": []
                    },
                    "configurations": {
                        "production": {
                            "budgets": [
                                {
                                    "type": "initial",
                                    "maximumWarning": "500kb",
                                    "maximumError": "1mb"
                                },
                                {
                                    "type": "anyComponentStyle",
                                    "maximumWarning": "2kb",
                                    "maximumError": "4kb"
                                }
                            ],
                            "fileReplacements": [
                                {
                                    "replace": "apps/ecommerce/src/environments/environment.ts",
                                    "with": "apps/ecommerce/src/environments/environment.prod.ts"
                                }
                            ],
                            "outputHashing": "all"
                        },
                        "development": {
                            "buildOptimizer": false,
                            "optimization": false,
                            "vendorChunk": true,
                            "extractLicenses": false,
                            "sourceMap": true,
                            "namedChunks": true
                        }
                    },
                    "defaultConfiguration": "production"
                },
                "serve": {
                    "executor": "@angular-devkit/build-angular:dev-server",
                    "configurations": {
                        "production": {
                            "browserTarget": "ecommerce:build:production"
                        },
                        "development": {
                            "browserTarget": "ecommerce:build:development"
                        }
                    },
                    "defaultConfiguration": "development"
                },
                "extract-i18n": {
                    "executor": "@angular-devkit/build-angular:extract-i18n",
                    "options": {
                        "browserTarget": "ecommerce:build"
                    }
                },
                "lint": {
                    "executor": "@nrwl/linter:eslint",
                    "options": {
                        "lintFilePatterns": [
                            "apps/ecommerce/**/*.ts",
                            "apps/ecommerce/**/*.html"
                        ]
                    }
                },
                "test": {
                    "executor": "@nrwl/jest:jest",
                    "outputs": ["coverage/apps/ecommerce"],
                    "options": {
                        "jestConfig": "apps/ecommerce/jest.config.ts",
                        "passWithNoTests": true
                    }
                }
            },
            "tags": []
        },
